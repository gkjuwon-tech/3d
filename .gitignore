# secrets — never commit API keys
.env
.env.*
*.key
secrets/

# python
__pycache__/
*.pyc
.venv/

# blender / 3d working files
*.blend1
*.blend2

# large downloaded assets — fetched by tools/fetch_assets.sh, not committed
assets/

# float passes are reproducible from tools/render_orthoviews.py in minutes and
# run ~12 MB per view; the 8-bit passes and cameras.json are committed
refs/*/depth/
refs/*/normal/

# reconstruction outputs: meshes and occupancy grids are large and are
# regenerated by tools/visual_hull.py in seconds. Metrics and comparison
# images are committed.
out/*.ply
out/*.npz
out/*_views*/

# npy mirrors of the float passes, written by tools/exr_to_npy.py
refs/*/depth_npy/
refs/*/normal_npy/
out/*/depth_npy/
out/*/normal_npy/

# the uploaded copy of the view set; the originals are under refs/
kaggle/views/

# kernel downloads; regenerated by re-running the Kaggle kernel
out/*_dl/
out/est*/

# photometric stereo light renders; regenerated by tools/photometric.py
out/photo*/

# camera-space normals solved by tools/photometric.py --solve; 673 MB of
# float arrays, regenerated from the light renders above
out/ps_normals/

# per-view depth maps and their confidence maps; regenerated by
# tools/depth_maps.py / tools/depth_mv.py
out/depth_ps/
out/depth_mv/
out/depth_contact/
# fused signed-distance fields (hundreds of MB) and cached GT surface samples
out/*_field.npy
out/gt_samples.npz
